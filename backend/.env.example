# Copy to .env for local development. Values here are examples, not production secrets.
APP_ENV=local
PORT=3000
DATABASE_URL=postgresql://qleanfeel_local:local-only-change-me@127.0.0.1:5432/qleanfeel_local
DATABASE_POOL_MAX=10
POSTGRES_LOCAL_DB=qleanfeel_local
POSTGRES_LOCAL_USER=qleanfeel_local
POSTGRES_LOCAL_PASSWORD=local-only-change-me
POSTGRES_LOCAL_PORT=5432
POSTGRES_TEST_DB=qleanfeel_test
POSTGRES_TEST_USER=qleanfeel_test
POSTGRES_TEST_PASSWORD=test-only-change-me
POSTGRES_TEST_PORT=5433

# DDL credential is read only by Drizzle Kit. Local Compose may use the same local
# role for convenience; staging/production must use a distinct migration principal.
MIGRATION_DATABASE_URL=postgresql://qleanfeel_local:local-only-change-me@127.0.0.1:5432/qleanfeel_local
