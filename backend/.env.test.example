# Copy to .env.test for local test runs. This points at the dedicated test PostgreSQL service.
APP_ENV=test
PORT=3001
DATABASE_URL=postgresql://qleanfeel_test:test-only-change-me@127.0.0.1:5433/qleanfeel_test
DATABASE_POOL_MAX=5
FIREBASE_PROJECT_ID=test-firebase-project
ACCESS_TOKEN_SIGNING_SECRET=test-only-change-me-with-at-least-32-bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=300
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
TEST_DATABASE_URL=postgresql://qleanfeel_test:test-only-change-me@127.0.0.1:5433/qleanfeel_test
MIGRATION_DATABASE_URL=postgresql://qleanfeel_test:test-only-change-me@127.0.0.1:5433/qleanfeel_test
POSTGRES_LOCAL_DB=qleanfeel_local
POSTGRES_LOCAL_USER=qleanfeel_local
POSTGRES_LOCAL_PASSWORD=local-test-only-change-me
POSTGRES_LOCAL_PORT=5432
POSTGRES_TEST_DB=qleanfeel_test
POSTGRES_TEST_USER=qleanfeel_test
POSTGRES_TEST_PASSWORD=test-only-change-me
POSTGRES_TEST_PORT=5433
